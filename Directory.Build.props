<Project>
  <PropertyGroup>
    <!-- Release verification can coexist with an open desktop development build. -->
    <BaseOutputPath Condition="'$(TernBuildOutputRoot)' != ''">$(TernBuildOutputRoot)/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Authors>Tern contributors</Authors>
    <Product>Tern</Product>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
