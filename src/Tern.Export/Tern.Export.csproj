    <Compile Include="../Tern.PreviewView/CodeSyntaxHighlighter.Languages.cs" Link="Syntax/CodeSyntaxHighlighter.Languages.cs" />
    <Compile Include="../Tern.PreviewView/CodeSyntaxHighlighter.Scanner.cs" Link="Syntax/CodeSyntaxHighlighter.Scanner.cs" />
    <Compile Include="../Tern.PreviewView/CodeDisplay.cs" Link="Syntax/CodeDisplay.cs" />
    <ProjectReference Include="..\Tern.Domain\Tern.Domain.csproj" />
    <ProjectReference Include="..\Tern.Filesystem\Tern.Filesystem.csproj" />
    <ProjectReference Include="..\Tern.Markdown\Tern.Markdown.csproj" />
    <ProjectReference Include="..\Tern.Rendering\Tern.Rendering.csproj" />
  </ItemGroup>

</Project>
